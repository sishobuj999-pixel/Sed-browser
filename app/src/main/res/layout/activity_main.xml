<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#00000000">

        <LinearLayout
            android:id="@+id/browserToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/toolbar_glass"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="SED Browser logo"
                android:src="@drawable/sed_logo" />

            <Button
                android:id="@+id/back"
                android:layout_width="40dp"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="‹"
                android:textSize="27sp"
                android:textColor="#E6FFFFFF"
                android:background="@drawable/control_glass"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <EditText
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:singleLine="true"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:hint="Search or enter address"
                android:textColor="#E6FFFFFF"
                android:textColorHint="#99FFFFFF"
                android:background="@drawable/address_glass"
                android:inputType="textUri"
                android:includeFontPadding="false" />

            <Button
                android:id="@+id/go"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Go"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#E6FFFFFF"
                android:background="@drawable/control_glass"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#00000000" />
    </LinearLayout>
</FrameLayout>
